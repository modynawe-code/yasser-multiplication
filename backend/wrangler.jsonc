{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yasser-khaled-family-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-01",
  "account_id": "cb1e4fe9d46768f7400d427eaecceb49",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://modynawe-code.github.io,http://127.0.0.1:4173,http://localhost:4173,http://localhost,https://localhost,capacitor://localhost",
    "SESSION_TTL_DAYS": "30"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "VOICE_RATE_LIMITER",
      "namespace_id": "2609071",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yasser-khaled-family",
      "database_id": "843c2084-7857-45a7-9b61-7ce064a9f7a0",
      "migrations_dir": "migrations"
    }
  ]
}
